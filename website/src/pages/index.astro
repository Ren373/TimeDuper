---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const en = `${base}en/`;
const ja = `${base}ja/`;
const site = Astro.site ?? new URL('https://ren373.github.io');
const enAbsolute = new URL(en, site);
const jaAbsolute = new URL(ja, site);
const logo = `${base}assets/timeduper-full-logo.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="HEvZZzXSAzcVvGTLjjFPOEOfpDYip5qDQzPvWnBUTGU" />
    <title>TimeDuper</title>
    <meta name="description" content="Choose English or Japanese to learn about TimeDuper for Instagram Web on iPhone Safari." />
    <link rel="canonical" href={enAbsolute} />
    <link rel="alternate" hreflang="en" href={enAbsolute} />
    <link rel="alternate" hreflang="ja" href={jaAbsolute} />
    <link rel="alternate" hreflang="x-default" href={enAbsolute} />
    <link rel="icon" type="image/png" href={`${base}assets/timeduper-td-logo.png`} />
    <style>
      :root { color-scheme: dark; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      * { box-sizing: border-box; }
      body { min-width: 320px; min-height: 100svh; margin: 0; display: grid; place-items: center; background: #070907; color: #fff; }
      main { width: min(90%, 34rem); text-align: center; }
      img { width: min(16rem, 70vw); height: auto; margin: 0 auto 2rem; }
      p { color: #a7aea7; }
      nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 2rem; }
      a { min-height: 3.1rem; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.16); border-radius: .8rem; color: #fff; font-weight: 700; text-decoration: none; }
      a:first-child { background: #78ff19; color: #071000; border-color: #78ff19; }
      a:focus-visible { outline: 3px solid #78ff19; outline-offset: 4px; }
    </style>
  </head>
  <body>
    <main>
      <img src={logo} width="280" height="241" alt="TimeDuper" />
      <h1>Choose your language</h1>
      <p>言語を選択してください</p>
      <nav aria-label="Language">
        <a href={en} lang="en" hreflang="en">English</a>
        <a href={ja} lang="ja" hreflang="ja">日本語</a>
      </nav>
    </main>
  </body>
</html>
