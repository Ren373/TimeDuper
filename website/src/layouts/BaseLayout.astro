---
import '../styles/global.css';

interface Props {
  lang: 'en' | 'ja';
  title: string;
  description: string;
  locale: string;
  canonicalPath?: string;
  alternatePaths?: { en: string; ja: string };
}

const { lang, title, description, locale, canonicalPath, alternatePaths } = Astro.props;
const baseWithSlash = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const base = baseWithSlash.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://ren373.github.io');
const localizedPath = (path: string) => `${base}/${path.replace(/^\/+/, '')}`;
const canonical = new URL(localizedPath(canonicalPath ?? `${lang}/`), site);
const enUrl = new URL(localizedPath(alternatePaths?.en ?? 'en/'), site);
const jaUrl = new URL(localizedPath(alternatePaths?.ja ?? 'ja/'), site);
const faviconUrl = `${baseWithSlash}assets/favicon.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070907" />
    <meta name="google-site-verification" content="HEvZZzXSAzcVvGTLjjFPOEOfpDYip5qDQzPvWnBUTGU" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/png" sizes="180x180" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={faviconUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TimeDuper" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
